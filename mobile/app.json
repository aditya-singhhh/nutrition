{
  "expo": {
    "name": "Health Companion",
    "slug": "health-companion",
    "version": "0.12.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.healthcompanion.app" },
    "android": {
      "package": "com.healthcompanion.app",
      "versionCode": 13,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow Health Companion to use the camera to scan food barcodes.", "recordAudioAndroid": false }],
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "Allow Health Companion to read a food or label photo you choose." }],
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ]
  }
}
